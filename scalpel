#!/usr/bin/env python3
"""scalpel — batch exact-match edits to one file, applied atomically.

Two verbs, and the pairing between them is the point:

    scalpel read FILE                     prints a content hash, then the file
    scalpel edit FILE --expect-hash H     applies edits, or refuses

`read` hands back the token that `edit` demands. That is compare-and-swap: the
hash is the version you saw, and an edit carrying a stale one is refused rather
than silently discarding whatever moved the file underneath you.

A shell rewrite (`sed -i`, `perl -pi`) has no such check. It succeeds on a file
that changed, succeeds on a pattern that matched the wrong place, and succeeds
when it matched nothing at all.
"""

import argparse
import difflib
import hashlib
import json
import os
import subprocess
import sys
import tempfile

CRLF = "\r\n"
NEWLINES = ("\n", CRLF)


WORKFLOW = """
the read/edit pairing:

  `read` prints a content hash. `edit --expect-hash` takes it back and refuses
  to write if the file no longer hashes to it. A file that moved between your
  read and your write is then refused rather than silently overwritten -- the
  check `sed -i` cannot have.

    $ scalpel read src/parser.rs --lines 1-3,40-60
    # scalpel 4f3a9c2b1e8d src/parser.rs
     1\tuse std::fmt;
     ...
    40\tfn parse(

    $ scalpel edit src/parser.rs --expect-hash 4f3a9c2b1e8d <<'EOF'
    [{"old": "fn parse(", "new": "fn parse_expr("}]
    EOF

  `--lines` takes any number of windows, so one call replaces
  `sed -n 'A,Bp;C,Dp'` and keeps the hash on every slice.

see `scalpel edit --help` for the edit format: exact-match replace, range
replace between two anchors, insert before/after an anchor, append, prepend.
"""

EDIT_FORMAT = """
edits arrive on stdin as a JSON array. Five ways of saying where:

    [{"old": "exact text", "new": "replacement"},
     {"old": "...", "new": "...", "replace_all": true},
     {"from": "fn old(", "until": "\\n#[test]", "new": ""},
     {"from": "fn parse(", "to": "\\n}\\n", "new": "fn parse(...) {\\n    ...\\n}\\n"},
     {"insert": "text\\n", "before": "anchor"},
     {"insert": "text\\n", "after": "anchor"},
     {"append": "text for the end of the file"},
     {"prepend": "text for the start"}]

`old`/`new`: `old` must match exactly and appear exactly once, unless
`replace_all` is set.

`from` + `to`/`until` + `new` replaces a range. `from` must appear exactly
once, like `old`. The range ends at the first `to` or `until` after it: `to`
keeps its anchor inside the range, `until` leaves it outside. An empty `new`
deletes the range. Use this when the body between two known lines is long and
quoting it whole as `old` would be the point of the edit.

`insert` + `before`/`after` puts text next to an anchor, which must appear
exactly once. The anchor is not repeated inside the text, and the text is
whole lines: both seams must land on line boundaries, or the edit is refused.
Use `old`/`new` to splice into the middle of a line.

`append` and `prepend` carry their text directly: the end and the start of a
file each name one place by construction, so they need no anchor.

`last: true` on `old`, `from`, `before` or `after` selects the last occurrence
in place of the uniqueness rule -- for the closing brace of a module, say,
which has no unique context except that it comes last.

All inserted text goes in byte for byte -- carry your own newlines -- and an
insert that would run into an existing line is refused rather than glued on.

Edits apply in order, each seeing what the one before it wrote. All of them
apply or none do: a failed batch writes nothing at all, and says where the
match nearly landed -- the line of a whitespace-only difference, every line of
an ambiguous match, or CRLF against LF.

A single edit object is accepted in place of a one-element array.

exit codes:
  2   an edit did not apply (not found, ambiguous, empty, or a no-op)
  3   --expect-hash did not match; the file changed since you read it
"""

# Every key an edit may carry. Anything else is most likely a typo for one of
# these, and a typo'd `until` or `last` that is silently ignored turns into a
# different edit than the one asked for.
KNOWN_KEYS = {"old", "new", "replace_all", "last", "from", "to", "until",
              "insert", "before", "after", "append", "prepend"}
WHERE_KEYS = ("old", "from", "insert", "append", "prepend")


def die(msg, code=1):
    print(f"scalpel: {msg}", file=sys.stderr)
    sys.exit(code)


def version():
    """The short hash of the checkout this script lives in, via the symlink.

    A copy that has drifted from the repo says so with no hash at all, which
    is the honest answer; a checkout with uncommitted changes says '-modified'.
    """
    here = os.path.dirname(os.path.realpath(__file__))
    try:
        out = subprocess.run(
            ["git", "-C", here, "describe", "--always", "--dirty=-modified"],
            capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError):
        return "unknown (not a git checkout)"
    return out.stdout.strip()


class Version(argparse.Action):
    """Like action='version', but runs git only when asked."""

    def __init__(self, option_strings, dest, **kw):
        super().__init__(option_strings, dest, nargs=0, help=kw.get("help"))

    def __call__(self, parser, namespace, values, option_string=None):
        print(f"scalpel {version()}")
        parser.exit()


def read_file(path):
    """Read preserving byte-exact line endings.

    newline='' stops Python translating CRLF to LF on the way in, so what we
    match against is what is actually on disk. A file that mixes endings is then
    matchable only by a pattern that mixes them the same way — which is correct,
    and is why diagnose() checks endings first.
    """
    try:
        with open(path, "r", encoding="utf-8", newline="") as f:
            return f.read()
    except FileNotFoundError:
        die(f"{path}: no such file")
    except IsADirectoryError:
        die(f"{path}: is a directory")
    except UnicodeDecodeError:
        die(f"{path}: not valid UTF-8; scalpel only edits text")


# 12 hex characters is 48 bits. This hash guards against a file changing by
# accident between a read and a write -- an editor, a formatter on save, another
# session -- not against an adversary constructing a collision. One in 2.8e14
# against accident is already far past the point where more characters buy
# anything, and the full 64 would be printed once and typed back once on every
# single edit.
#
# A longer prefix is still accepted, so a hash taken before this was shortened,
# or a full digest from sha256sum, keeps working.
SHORT = 12


def digest(text, n=SHORT):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:n]


def line_of(text, offset):
    return text.count("\n", 0, offset) + 1


def find_all(hay, needle):
    """Non-overlapping occurrences, matching str.replace semantics.

    Overlapping counts would report `aaa` as ambiguous inside `aaaa`, which is
    true but never what the caller means.
    """
    out, i = [], hay.find(needle)
    while i != -1:
        out.append(i)
        i = hay.find(needle, i + len(needle))
    return out


def diagnose(text, old, base=0):
    """Say where `old` nearly matched, and how it differed.

    This is the whole reason to prefer a tool over a raw rewrite. "not found"
    costs a re-read to resolve; "matches at line 240 but the whitespace differs"
    costs nothing.

    `base` is added to every line number, for a caller that searched a tail of
    the file and wants the numbers to mean lines of the whole.
    """
    # Line endings first: invisible, and the most common single cause.
    if CRLF in text and CRLF not in old and old.replace("\n", CRLF) in text:
        return "file uses CRLF line endings, your text uses LF"
    if CRLF in old and CRLF not in text and old.replace(CRLF, "\n") in text:
        return "file uses LF line endings, your text uses CRLF"

    old_lines = old.split("\n")
    file_lines = text.split("\n")
    n = len(old_lines)
    o_strip = [l.strip() for l in old_lines]
    f_strip = [l.strip() for l in file_lines]

    # Same lines, different leading/trailing whitespace.
    if n <= len(file_lines):
        for i in range(len(file_lines) - n + 1):
            if f_strip[i:i + n] == o_strip:
                return f"matches at line {base + i + 1} but the whitespace differs"

    # Anchor on the first non-blank line, then score the window it starts.
    anchor = next((s for s in o_strip if s), None)
    best_ratio, best_at = 0.0, None
    if anchor:
        for i, s in enumerate(f_strip):
            if s != anchor:
                continue
            window = "\n".join(file_lines[i:i + n])
            r = difflib.SequenceMatcher(None, old, window).ratio()
            if r > best_ratio:
                best_ratio, best_at = r, i
        # No exact anchor line: fall back to the closest one there is.
        if best_at is None:
            close = difflib.get_close_matches(
                anchor, [s for s in f_strip if s], n=1, cutoff=0.6
            )
            if close:
                best_at = f_strip.index(close[0])
                window = "\n".join(file_lines[best_at:best_at + n])
                best_ratio = difflib.SequenceMatcher(None, old, window).ratio()

    if best_at is None:
        return "no similar text found"

    window = "\n".join(file_lines[best_at:best_at + n])
    diff = difflib.unified_diff(
        old.split("\n"), window.split("\n"),
        fromfile="yours", tofile=f"file:{base + best_at + 1}", lineterm="", n=1,
    )
    body = "\n".join("    " + d for d in list(diff)[2:][:12])
    return (f"closest match at line {base + best_at + 1} "
            f"({int(best_ratio * 100)}% similar)\n{body}")


def locate(buf, key, edit, idx):
    """Find the one place `edit[key]` names in `buf`.

    Exactly once is the rule, because a match that could have landed in two
    places proves nothing about which one you meant. `last: true` is the one
    relaxation: it names the final occurrence, which is a position as definite
    as the end of the file, and is what a closing brace has instead of context.

    Returns (offset, note, None) or (None, None, error). `note` is appended to
    the report line so the reader can see that `last` did the choosing.
    """
    needle = edit[key]
    if not isinstance(needle, str):
        return None, None, f"edit {idx}: '{key}' must be a string"
    if needle == "":
        return None, None, f"edit {idx}: '{key}' is empty"
    hits = find_all(buf, needle)
    if not hits:
        return None, None, f"edit {idx}: '{key}' not found — {diagnose(buf, needle)}"
    if edit.get("last"):
        note = "" if len(hits) == 1 else f" (last of {len(hits)})"
        return hits[-1], note, None
    if len(hits) > 1:
        shown = ", ".join(str(line_of(buf, h)) for h in hits[:8])
        more = "" if len(hits) <= 8 else f", +{len(hits) - 8} more"
        hint = ("add surrounding context, set \"last\": true"
                + (", or set \"replace_all\": true" if key == "old" else ""))
        return None, None, (f"edit {idx}: '{key}' has {len(hits)} matches "
                            f"(lines {shown}{more}) — {hint}")
    return hits[0], "", None


def splice_in(buf, at, add, idx, where):
    """Put `add` into `buf` at offset `at`, refusing a seam that would corrupt.

    Naming a position instead of quoting one means the edit cannot land in the
    wrong place. What it cannot see is the join, so the two ways a join silently
    corrupts are refused: text that would continue the line before it, and text
    that would run into the line after it. Both look like success and both are
    found later by a compiler, if at all.

    Returns (buf, line_count, None) or (buf, None, error).
    """
    if not isinstance(add, str):
        return buf, None, f"edit {idx}: '{where}' must be a string"
    if add == "":
        return buf, None, f"edit {idx}: '{where}' is empty"
    if CRLF in buf and CRLF not in add and "\n" in add:
        return buf, None, (f"edit {idx}: file uses CRLF line endings, "
                           f"your '{where}' text uses LF")

    # Inserted byte for byte. No newline is added for you: guessing one is the
    # sort of silent adjustment this tool exists to avoid, and a caller who
    # wants a blank line above a new function must be able to ask for one.
    left_ok = at == 0 or buf[at - 1] == "\n" or add.startswith(NEWLINES)
    if not left_ok:
        return buf, None, (
            f"edit {idx}: line {line_of(buf, at)} has no trailing newline "
            f"before this point, so the text would continue it -- begin the "
            f"text with a newline, or anchor an 'old'/'new' edit on that line")
    right_ok = at == len(buf) or buf.startswith(NEWLINES, at) or add.endswith("\n")
    if not right_ok:
        return buf, None, (
            f"edit {idx}: the text has no trailing newline, so it would run "
            f"into line {line_of(buf, at)} -- end the text with a newline, or "
            f"anchor an 'old'/'new' edit on that line")

    buf = buf[:at] + add + buf[at:]
    return buf, add.count("\n") + (0 if add.endswith("\n") else 1), None


def plural(n, noun):
    return f"{n} {noun}" if n == 1 else f"{n} {noun}s"


def apply_edits(text, edits):
    """Apply edits sequentially to an in-memory buffer.

    Sequential, so a later edit sees what an earlier one wrote — the same
    semantics as editing one hunk at a time. In memory, so a failure at edit 7
    leaves the file untouched rather than half-rewritten. Those two properties
    are the reason this is not a loop around sed.

    Returns (new_text, report_lines) or (None, error_message).
    """
    buf = text
    report = []
    for idx, e in enumerate(edits, 1):
        if not isinstance(e, dict):
            return None, f"edit {idx}: needs an object"

        unknown = sorted(set(e) - KNOWN_KEYS)
        if unknown:
            return None, (f"edit {idx}: unknown key "
                          f"{', '.join(repr(k) for k in unknown)}")

        # Exactly one way of saying where. `old` and `from` say it by quoting
        # the file; `insert` by quoting a neighbour; `append` and `prepend` by
        # naming a position that cannot be ambiguous. Two of them in one
        # object is a caller who meant neither.
        keys = [k for k in WHERE_KEYS if k in e]
        if len(keys) != 1:
            found = ", ".join(f"'{k}'" for k in keys) if keys else "none"
            return None, (f"edit {idx}: needs exactly one of "
                          + ", ".join(f"'{k}'" for k in WHERE_KEYS)
                          + f" -- found {found}")
        where = keys[0]

        for flag in ("last", "replace_all"):
            if flag in e and not isinstance(e[flag], bool):
                return None, f"edit {idx}: '{flag}' must be true or false"
        if e.get("last") and e.get("replace_all"):
            return None, f"edit {idx}: 'last' and 'replace_all' contradict"
        if e.get("replace_all") and where != "old":
            return None, f"edit {idx}: 'replace_all' means nothing with '{where}'"
        if e.get("last") and where in ("append", "prepend"):
            return None, f"edit {idx}: 'last' means nothing with '{where}'"

        # -- append / prepend -------------------------------------------------
        if where in ("append", "prepend"):
            if "new" in e:
                return None, (f"edit {idx}: '{where}' carries the text itself; "
                              f"there is no 'new'")
            at = len(buf) if where == "append" else 0
            buf, n, err = splice_in(buf, at, e[where], idx, where)
            if err:
                return None, err
            report.append(f"  edit {idx}: {where}ed {plural(n, 'line')} "
                          f"at line {line_of(buf, at)}")
            continue

        # -- insert before / after --------------------------------------------
        if where == "insert":
            if "new" in e:
                return None, (f"edit {idx}: 'insert' carries the text itself; "
                              f"there is no 'new'")
            sides = [k for k in ("before", "after") if k in e]
            if len(sides) != 1:
                return None, (f"edit {idx}: 'insert' needs exactly one of "
                              f"'before', 'after'")
            side = sides[0]
            start, note, err = locate(buf, side, e, idx)
            if err:
                return None, err
            at = start if side == "before" else start + len(e[side])
            # Reported in the numbering of the file as read, like every other
            # edit, so the line can be checked against the `read` that led here.
            anchor_line = line_of(buf, start)
            buf, n, err = splice_in(buf, at, e["insert"], idx, "insert")
            if err:
                return None, err
            report.append(f"  edit {idx}: inserted {plural(n, 'line')} "
                          f"{side} line {anchor_line}{note}")
            continue

        # -- old / from both replace, and both need a new --------------------
        if "new" not in e:
            return None, f"edit {idx}: '{where}' needs a matching 'new'"
        new = e["new"]
        if not isinstance(new, str):
            return None, f"edit {idx}: 'new' must be a string"

        # -- old / new ---------------------------------------------------------
        if where == "old":
            old = e["old"]
            if e.get("replace_all"):
                if not isinstance(old, str):
                    return None, f"edit {idx}: 'old' must be a string"
                if old == "":
                    return None, f"edit {idx}: 'old' is empty"
                if old == new:
                    return None, f"edit {idx}: 'old' and 'new' are identical"
                hits = find_all(buf, old)
                if not hits:
                    return None, f"edit {idx}: 'old' not found — {diagnose(buf, old)}"
                lines = [line_of(buf, h) for h in hits]
                buf = buf.replace(old, new)
                shown = ", ".join(str(x) for x in lines[:8])
                more = "" if len(lines) <= 8 else f", +{len(lines) - 8} more"
                report.append(f"  edit {idx}: {len(hits)} replacements "
                              f"(lines {shown}{more})")
                continue
            if old == new:
                return None, f"edit {idx}: 'old' and 'new' are identical"
            start, note, err = locate(buf, "old", e, idx)
            if err:
                return None, err
            report.append(f"  edit {idx}: line {line_of(buf, start)}{note}")
            buf = buf[:start] + new + buf[start + len(old):]
            continue

        # -- from / to|until ---------------------------------------------------
        ends = [k for k in ("to", "until") if k in e]
        if len(ends) != 1:
            return None, f"edit {idx}: 'from' needs exactly one of 'to', 'until'"
        endkey = ends[0]
        stop = e[endkey]
        if not isinstance(stop, str):
            return None, f"edit {idx}: '{endkey}' must be a string"
        if stop == "":
            return None, f"edit {idx}: '{endkey}' is empty"
        start, note, err = locate(buf, "from", e, idx)
        if err:
            return None, err
        # The end is the first occurrence after `from`, searched from where
        # `from` finishes so the two anchors cannot overlap. First rather than
        # unique, because "up to the next test" is the whole idiom.
        after = start + len(e["from"])
        j = buf.find(stop, after)
        if j == -1:
            from_line = line_of(buf, start)
            return None, (f"edit {idx}: '{endkey}' not found after 'from' "
                          f"(line {from_line}) — "
                          f"{diagnose(buf[after:], stop, base=line_of(buf, after) - 1)}")
        end = j + len(stop) if endkey == "to" else j
        if buf[start:end] == new:
            return None, f"edit {idx}: the range already reads as 'new'"
        first, final = line_of(buf, start), line_of(buf, max(start, end - 1))
        span = f"line {first}" if first == final else f"lines {first}-{final}"
        what = "deleted" if new == "" else "replaced"
        report.append(f"  edit {idx}: {span} {what}{note}")
        buf = buf[:start] + new + buf[end:]

    return buf, report


def write_atomic(path, text):
    """Replace via a temp file in the same directory, so the swap is atomic.

    Same directory because os.replace is only atomic within a filesystem. A
    crash mid-write leaves the original intact, never a truncated file.
    """
    d = os.path.dirname(os.path.abspath(path))
    mode = os.stat(path).st_mode & 0o7777
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".scalpel-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def parse_windows(spec):
    """Turn `12-40,90,200-` into [(12, 40), (90, 90), (200, None)]."""
    out = []
    for part in spec.split(","):
        part = part.strip()
        a, dash, b = part.partition("-")
        try:
            lo = int(a)
            hi = None if (dash and b == "") else (int(b) if dash else lo)
        except ValueError:
            die(f"--lines: '{part}' is not a line number or A-B range")
        if lo < 1 or (hi is not None and hi < lo):
            die(f"--lines: '{part}' is not a valid range")
        out.append((lo, hi))
    return out


def cmd_read(args):
    text = read_file(args.file)
    print(f"# scalpel {digest(text)} {args.file}")
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()          # a trailing newline is not a trailing empty line
    windows = parse_windows(args.lines) if args.lines else [(1, None)]
    windows = [(lo, len(lines) if hi is None else min(hi, len(lines)))
               for lo, hi in windows]
    width = len(str(max([hi for _, hi in windows] + [1])))
    for lo, hi in windows:
        if lo > len(lines):
            print(f"scalpel: {args.file} has {len(lines)} lines; "
                  f"{lo}- is past the end", file=sys.stderr)
            continue
        for i in range(lo, hi + 1):
            print(f"{str(i).rjust(width)}\t{lines[i - 1]}")
    return 0


def cmd_digest(args):
    print(digest(read_file(args.file)))
    return 0


def cmd_edit(args):
    text = read_file(args.file)

    # The version check, before anything else looks at the content.
    if args.expect_hash:
        want = args.expect_hash.strip().lower()
        if len(want) < 8 or want.strip("0123456789abcdef"):
            die("--expect-hash wants at least 8 hex characters, "
                "as printed by `scalpel read`")
        # Compared at whatever length was supplied, so a full digest and a short
        # one are both simply equality against the same prefix.
        actual = digest(text, len(want))
        if actual != want:
            die(f"{args.file} changed since you read it\n"
                f"  expected {want}\n"
                f"  actual   {actual}\n"
                f"  re-read the file; something else wrote it "
                f"(you, a linter, a hook, another session)", 3)

    raw = sys.stdin.read().strip()
    if not raw:
        die("no edits on stdin; expected a JSON array of {\"old\", \"new\"}")
    try:
        edits = json.loads(raw)
    except json.JSONDecodeError as ex:
        die(f"stdin is not valid JSON: {ex}")
    if isinstance(edits, dict):
        edits = [edits]
    if not isinstance(edits, list) or not edits:
        die("expected a non-empty JSON array of edits")

    result, report = apply_edits(text, edits)
    if result is None:
        die(f"{report}\n  nothing was written", 2)

    if result == text:
        die("edits produced no change", 2)

    if args.dry_run:
        diff = difflib.unified_diff(
            text.split("\n"), result.split("\n"),
            fromfile=f"a/{args.file}", tofile=f"b/{args.file}", lineterm="",
        )
        print("\n".join(diff))
        print(f"scalpel: {len(edits)} edits would apply "
              f"(dry run, nothing written)", file=sys.stderr)
        return 0

    write_atomic(args.file, result)
    plural = "edit" if len(edits) == 1 else "edits"
    print(f"scalpel: {len(edits)} {plural} applied to {args.file}")
    for line in report:
        print(line)
    print(f"# scalpel {digest(result)} {args.file}")
    return 0


def main():
    p = argparse.ArgumentParser(
        prog="scalpel",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Batch exact-match edits to one file, applied atomically.",
        epilog=WORKFLOW)
    p.add_argument("--version", action=Version,
                   help="print the git short hash of this checkout")
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("read", help="print a content hash, then the file")
    r.add_argument("file")
    r.add_argument("--lines", metavar="A-B[,C-D...]",
                   help="print only these windows (1-based, inclusive; "
                        "'42' is one line, '200-' runs to the end)")
    r.set_defaults(fn=cmd_read)

    h = sub.add_parser("digest", help="print the content hash alone")
    h.add_argument("file")
    h.set_defaults(fn=cmd_digest)

    e = sub.add_parser("edit", help="apply JSON edits from stdin",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       epilog=EDIT_FORMAT)
    e.add_argument("file")
    e.add_argument("--expect-hash", metavar="SHA",
                   help="refuse if the file no longer hashes to this")
    e.add_argument("--dry-run", action="store_true",
                   help="print a unified diff, write nothing")
    e.set_defaults(fn=cmd_edit)

    args = p.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
