#!/usr/bin/env python3
"""scalpel — batch exact-match edits to one file, applied atomically.

Two verbs, and the pairing between them is the point:

    scalpel read FILE                     prints a content hash, then the file
    scalpel edit FILE --expect-hash H     applies edits, or refuses

`read` hands back the token that `edit` demands. That is compare-and-swap: the
hash is the version you saw, and an edit carrying a stale one is refused rather
than silently discarding whatever moved the file underneath you.

A shell rewrite (`sed -i`, `perl -pi`) has no such check. It succeeds on a file
that changed, succeeds on a pattern that matched the wrong place, and succeeds
when it matched nothing at all.
"""

import argparse
import difflib
import hashlib
import json
import os
import sys
import tempfile

CRLF = "\r\n"


WORKFLOW = """
the read/edit pairing:

  `read` prints a content hash. `edit --expect-hash` takes it back and refuses
  to write if the file no longer hashes to it. A file that moved between your
  read and your write is then refused rather than silently overwritten -- the
  check `sed -i` cannot have.

    $ scalpel read src/parser.rs
    # scalpel 4f3a9c2b1e8d src/parser.rs
    1\tuse std::fmt;

    $ scalpel edit src/parser.rs --expect-hash 4f3a9c2b1e8d <<'EOF'
    [{"old": "fn parse(", "new": "fn parse_expr("}]
    EOF

see `scalpel edit --help` for the edit format.
"""

EDIT_FORMAT = """
edits arrive on stdin as a JSON array:

    [{"old": "exact text", "new": "replacement"},
     {"old": "...", "new": "...", "replace_all": true},
     {"append": "text for the end of the file"},
     {"prepend": "text for the start"}]

`old` must match exactly and appear exactly once, unless `replace_all` is set.

`append` and `prepend` carry their text directly and take no `old`: the end and
the start of a file are the two positions that name one place by construction,
so they need nothing quoted to be unambiguous. The text goes in byte for byte
-- carry your own newlines -- and an insert that would run into an existing
line is refused rather than glued on.

Edits apply in order, each seeing what the one before it wrote. All of them
apply or none do: a failed batch writes nothing at all, and says where the
match nearly landed -- the line of a whitespace-only difference, every line of
an ambiguous match, or CRLF against LF.

A single edit object is accepted in place of a one-element array.

exit codes:
  2   an edit did not apply (not found, ambiguous, empty, or a no-op)
  3   --expect-hash did not match; the file changed since you read it
"""


def die(msg, code=1):
    print(f"scalpel: {msg}", file=sys.stderr)
    sys.exit(code)


def read_file(path):
    """Read preserving byte-exact line endings.

    newline='' stops Python translating CRLF to LF on the way in, so what we
    match against is what is actually on disk. A file that mixes endings is then
    matchable only by a pattern that mixes them the same way — which is correct,
    and is why diagnose() checks endings first.
    """
    try:
        with open(path, "r", encoding="utf-8", newline="") as f:
            return f.read()
    except FileNotFoundError:
        die(f"{path}: no such file")
    except IsADirectoryError:
        die(f"{path}: is a directory")
    except UnicodeDecodeError:
        die(f"{path}: not valid UTF-8; scalpel only edits text")


# 12 hex characters is 48 bits. This hash guards against a file changing by
# accident between a read and a write -- an editor, a formatter on save, another
# session -- not against an adversary constructing a collision. One in 2.8e14
# against accident is already far past the point where more characters buy
# anything, and the full 64 would be printed once and typed back once on every
# single edit.
#
# A longer prefix is still accepted, so a hash taken before this was shortened,
# or a full digest from sha256sum, keeps working.
SHORT = 12


def digest(text, n=SHORT):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:n]


def line_of(text, offset):
    return text.count("\n", 0, offset) + 1


def find_all(hay, needle):
    """Non-overlapping occurrences, matching str.replace semantics.

    Overlapping counts would report `aaa` as ambiguous inside `aaaa`, which is
    true but never what the caller means.
    """
    out, i = [], hay.find(needle)
    while i != -1:
        out.append(i)
        i = hay.find(needle, i + len(needle))
    return out


def diagnose(text, old):
    """Say where `old` nearly matched, and how it differed.

    This is the whole reason to prefer a tool over a raw rewrite. "not found"
    costs a re-read to resolve; "matches at line 240 but the whitespace differs"
    costs nothing.
    """
    # Line endings first: invisible, and the most common single cause.
    if CRLF in text and CRLF not in old and old.replace("\n", CRLF) in text:
        return "file uses CRLF line endings, your old text uses LF"
    if CRLF in old and CRLF not in text and old.replace(CRLF, "\n") in text:
        return "file uses LF line endings, your old text uses CRLF"

    old_lines = old.split("\n")
    file_lines = text.split("\n")
    n = len(old_lines)
    o_strip = [l.strip() for l in old_lines]
    f_strip = [l.strip() for l in file_lines]

    # Same lines, different leading/trailing whitespace.
    if n <= len(file_lines):
        for i in range(len(file_lines) - n + 1):
            if f_strip[i:i + n] == o_strip:
                return f"matches at line {i + 1} but the whitespace differs"

    # Anchor on the first non-blank line, then score the window it starts.
    anchor = next((s for s in o_strip if s), None)
    best_ratio, best_at = 0.0, None
    if anchor:
        for i, s in enumerate(f_strip):
            if s != anchor:
                continue
            window = "\n".join(file_lines[i:i + n])
            r = difflib.SequenceMatcher(None, old, window).ratio()
            if r > best_ratio:
                best_ratio, best_at = r, i
        # No exact anchor line: fall back to the closest one there is.
        if best_at is None:
            close = difflib.get_close_matches(
                anchor, [s for s in f_strip if s], n=1, cutoff=0.6
            )
            if close:
                best_at = f_strip.index(close[0])
                window = "\n".join(file_lines[best_at:best_at + n])
                best_ratio = difflib.SequenceMatcher(None, old, window).ratio()

    if best_at is None:
        return "no similar text found"

    window = "\n".join(file_lines[best_at:best_at + n])
    diff = difflib.unified_diff(
        old.split("\n"), window.split("\n"),
        fromfile="yours", tofile=f"file:{best_at + 1}", lineterm="", n=1,
    )
    body = "\n".join("    " + d for d in list(diff)[2:][:12])
    return (f"closest match at line {best_at + 1} "
            f"({int(best_ratio * 100)}% similar)\n{body}")


def insert(buf, where, edit, idx):
    """Add text at one of the two positions that need no anchor.

    The end of a file and the start of a file each name exactly one place by
    construction, so they keep the property `old` buys by quoting the file:
    there is no second candidate to land on by mistake. What they cannot check
    is the seam, so the ways a seam silently corrupts are refused outright.

    Returns (buf, report_line, None) or (buf, None, error).
    """
    if "new" in edit:
        return buf, None, (f"edit {idx}: '{where}' carries the text itself; "
                           f"there is no 'new'")
    if edit.get("replace_all"):
        return buf, None, (f"edit {idx}: 'replace_all' means nothing "
                           f"with '{where}'")
    add = edit[where]
    if not isinstance(add, str):
        return buf, None, f"edit {idx}: '{where}' must be a string"
    if add == "":
        return buf, None, f"edit {idx}: '{where}' is empty"

    # Inserted byte for byte. No newline is added for you: guessing one is the
    # sort of silent adjustment this tool exists to avoid, and a caller who
    # wants a blank line above a new function must be able to ask for one. The
    # seam is checked instead -- text that would run into an existing line is
    # refused, because that is the failure that looks like success.
    if buf:
        if CRLF in buf and CRLF not in add and "\n" in add:
            return buf, None, (f"edit {idx}: file uses CRLF line endings, "
                               f"your '{where}' text uses LF")
        if where == "append" and not buf.endswith("\n") and not add.startswith("\n"):
            return buf, None, (
                f"edit {idx}: the file has no trailing newline, so this would "
                f"continue line {line_of(buf, len(buf))} -- begin the text with "
                f"a newline, or anchor an 'old'/'new' edit on that line")
        if where == "prepend" and not add.endswith("\n"):
            return buf, None, (
                f"edit {idx}: the text has no trailing newline, so it would run "
                f"into line 1 -- end the text with a newline, or anchor an "
                f"'old'/'new' edit on that line")

    at = len(buf) if where == "append" else 0
    buf = buf[:at] + add + buf[at:]
    n = add.count("\n") + (0 if add.endswith("\n") else 1)
    return buf, (f"  edit {idx}: {where}ed {n} "
                 f"{'line' if n == 1 else 'lines'} at line {line_of(buf, at)}"), None


def apply_edits(text, edits):
    """Apply edits sequentially to an in-memory buffer.

    Sequential, so a later edit sees what an earlier one wrote — the same
    semantics as editing one hunk at a time. In memory, so a failure at edit 7
    leaves the file untouched rather than half-rewritten. Those two properties
    are the reason this is not a loop around sed.

    Returns (new_text, report_lines) or (None, error_message).
    """
    buf = text
    report = []
    for idx, e in enumerate(edits, 1):
        if not isinstance(e, dict):
            return None, f"edit {idx}: needs an object"

        # Exactly one way of saying where. `old` says it by quoting the file;
        # `append` and `prepend` say it by naming a position that cannot be
        # ambiguous. Two of them in one object is a caller who meant neither.
        keys = [k for k in ("old", "append", "prepend") if k in e]
        if len(keys) != 1:
            found = ", ".join(f"'{k}'" for k in keys) if keys else "none"
            return None, (f"edit {idx}: needs exactly one of 'old', 'append', "
                          f"'prepend' -- found {found}")

        if keys[0] != "old":
            buf, line, err = insert(buf, keys[0], e, idx)
            if err:
                return None, err
            report.append(line)
            continue

        if "new" not in e:
            return None, f"edit {idx}: 'old' needs a matching 'new'"
        old, new = e["old"], e["new"]
        if not isinstance(old, str) or not isinstance(new, str):
            return None, f"edit {idx}: 'old' and 'new' must be strings"
        if old == "":
            return None, f"edit {idx}: 'old' is empty"
        if old == new:
            return None, f"edit {idx}: 'old' and 'new' are identical"

        hits = find_all(buf, old)
        if not hits:
            return None, f"edit {idx}: not found — {diagnose(buf, old)}"

        if e.get("replace_all"):
            lines = [line_of(buf, h) for h in hits]
            buf = buf.replace(old, new)
            shown = ", ".join(str(x) for x in lines[:8])
            more = "" if len(lines) <= 8 else f", +{len(lines) - 8} more"
            report.append(f"  edit {idx}: {len(hits)} replacements "
                          f"(lines {shown}{more})")
        elif len(hits) > 1:
            shown = ", ".join(str(line_of(buf, h)) for h in hits[:8])
            more = "" if len(hits) <= 8 else f", +{len(hits) - 8} more"
            return None, (f"edit {idx}: {len(hits)} matches (lines {shown}{more})"
                          f" — add surrounding context, or set"
                          f" \"replace_all\": true")
        else:
            report.append(f"  edit {idx}: line {line_of(buf, hits[0])}")
            buf = buf[:hits[0]] + new + buf[hits[0] + len(old):]

    return buf, report


def write_atomic(path, text):
    """Replace via a temp file in the same directory, so the swap is atomic.

    Same directory because os.replace is only atomic within a filesystem. A
    crash mid-write leaves the original intact, never a truncated file.
    """
    d = os.path.dirname(os.path.abspath(path))
    mode = os.stat(path).st_mode & 0o7777
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".scalpel-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def cmd_read(args):
    text = read_file(args.file)
    print(f"# scalpel {digest(text)} {args.file}")
    lines = text.split("\n")
    start = max(1, args.offset)
    if start > len(lines):
        return 0
    end = len(lines) if args.limit is None else min(len(lines), start + args.limit - 1)
    width = len(str(end))
    for i in range(start, end + 1):
        print(f"{str(i).rjust(width)}\t{lines[i - 1]}")
    return 0


def cmd_digest(args):
    print(digest(read_file(args.file)))
    return 0


def cmd_edit(args):
    text = read_file(args.file)

    # The version check, before anything else looks at the content.
    if args.expect_hash:
        want = args.expect_hash.strip().lower()
        if len(want) < 8 or want.strip("0123456789abcdef"):
            die("--expect-hash wants at least 8 hex characters, "
                "as printed by `scalpel read`")
        # Compared at whatever length was supplied, so a full digest and a short
        # one are both simply equality against the same prefix.
        actual = digest(text, len(want))
        if actual != want:
            die(f"{args.file} changed since you read it\n"
                f"  expected {want}\n"
                f"  actual   {actual}\n"
                f"  re-read the file; something else wrote it "
                f"(you, a linter, a hook, another session)", 3)

    raw = sys.stdin.read().strip()
    if not raw:
        die("no edits on stdin; expected a JSON array of {\"old\", \"new\"}")
    try:
        edits = json.loads(raw)
    except json.JSONDecodeError as ex:
        die(f"stdin is not valid JSON: {ex}")
    if isinstance(edits, dict):
        edits = [edits]
    if not isinstance(edits, list) or not edits:
        die("expected a non-empty JSON array of edits")

    result, report = apply_edits(text, edits)
    if result is None:
        die(f"{report}\n  nothing was written", 2)

    if result == text:
        die("edits produced no change", 2)

    if args.dry_run:
        diff = difflib.unified_diff(
            text.split("\n"), result.split("\n"),
            fromfile=f"a/{args.file}", tofile=f"b/{args.file}", lineterm="",
        )
        print("\n".join(diff))
        print(f"scalpel: {len(edits)} edits would apply "
              f"(dry run, nothing written)", file=sys.stderr)
        return 0

    write_atomic(args.file, result)
    plural = "edit" if len(edits) == 1 else "edits"
    print(f"scalpel: {len(edits)} {plural} applied to {args.file}")
    for line in report:
        print(line)
    print(f"# scalpel {digest(result)} {args.file}")
    return 0


def main():
    p = argparse.ArgumentParser(
        prog="scalpel",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Batch exact-match edits to one file, applied atomically.",
        epilog=WORKFLOW)
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("read", help="print a content hash, then the file")
    r.add_argument("file")
    r.add_argument("--offset", type=int, default=1, help="first line (1-based)")
    r.add_argument("--limit", type=int, default=None, help="how many lines")
    r.set_defaults(fn=cmd_read)

    h = sub.add_parser("digest", help="print the content hash alone")
    h.add_argument("file")
    h.set_defaults(fn=cmd_digest)

    e = sub.add_parser("edit", help="apply JSON edits from stdin",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       epilog=EDIT_FORMAT)
    e.add_argument("file")
    e.add_argument("--expect-hash", metavar="SHA",
                   help="refuse if the file no longer hashes to this")
    e.add_argument("--dry-run", action="store_true",
                   help="print a unified diff, write nothing")
    e.set_defaults(fn=cmd_edit)

    args = p.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
